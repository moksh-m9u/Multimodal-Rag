# Copy to .streamlit/secrets.toml (gitignored) only when the dashboard should
# call a backend other than the default in config/settings.py.
#
# Streamlit copies every root-level key here into os.environ and overwrites
# values that are already set, so a key in this file beats an
# API_BASE_URL=... prefix on the command line.
#
# On Streamlit Cloud, put the same keys in the app's Settings > Secrets page.
API_BASE_URL = "https://your-backend.example.com"
